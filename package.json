{
  "name": "markdown2blog",
  "version": "0.1.0",
  "description": "Markdown to blog generator written in TypeScript",
  "type": "module",
  "bin": {
    "md2blog": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "node dist/cli.js build",
    "serve": "node dist/cli.js serve",
    "clean": "rm -rf dist site",
    "start": "npm run build && npm run generate"
  },
  "keywords": [
    "markdown",
    "blog",
    "static-site-generator",
    "ssg"
  ],
  "license": "MIT",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
